{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${mod_version}",
  "license": "MIT",

  "description": "${mod_description}",
  "authors": [
    "Nick Robson"
  ],

  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.nickrobson.minecraft.skillmmo.SkillMmoMod"
    ],
    "client": [
      "dev.nickrobson.minecraft.skillmmo.SkillMmoClientInitializer"
    ],
    "fabric-datagen": [
      "dev.nickrobson.minecraft.skillmmo.data.generation.SkillMmoDataGenerator"
    ]
  },
  "mixins": [
    "skillmmo.mixins.json"
  ],

  "depends": {
    "java": "${java_version_range}",
    "minecraft": "${minecraft_version_range}",
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "cloth-config2": "${cloth_config_version_range}"
  },
  "suggests": {
    "wthit": "${wthit_version_range}"
  }
}
